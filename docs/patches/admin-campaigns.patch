+import TrashIcon from '@/assets/icons/trash.svg?react'
+import type { Campaign, CampaignStatus } from '@/types/campaign'
+import { formatDateTime } from '@/utils/format'
+
+const STATUS: Record<CampaignStatus, { label: string; className: string }> = {
+	DRAFT: { label: 'Черновик', className: 'bg-foreground/5 text-secondary' },
+	SENDING: { label: 'Отправляется', className: 'bg-orange/10 text-orange' },
+	COMPLETED: { label: 'Отправлена', className: 'bg-sale/10 text-sale' },
+	FAILED: { label: 'Ошибка', className: 'bg-danger/10 text-danger' }
+}
+
+type Props = {
+	campaign: Campaign
+	onSend: (c: Campaign) => void
+	onDelete: (c: Campaign) => void
+}
+
+export function CampaignItem({ campaign, onSend, onDelete }: Props) {
+	const status = STATUS[campaign.status] ?? STATUS.DRAFT
+	const canSend = campaign.status === 'DRAFT' || campaign.status === 'FAILED'
+
+	return (
+		<div className="flex flex-wrap items-center gap-x-4 gap-y-2 bg-foreground/3 rounded-2xl px-6 py-4">
+			<div className="flex-1 min-w-48 flex flex-col gap-1">
+				<span className="font-medium truncate">{campaign.subject}</span>
+				<span className="text-[13px] text-secondary">
+					{formatDateTime(campaign.createdAt)}
+					{campaign.totalCount > 0 &&
+						` · доставлено ${campaign.sentCount} из ${campaign.totalCount}`}
+					{campaign.failedCount > 0 && ` · ошибок ${campaign.failedCount}`}
+				</span>
+			</div>
+
+			<span
+				className={`text-[10px] font-bold uppercase px-3 py-1 rounded-full shrink-0 ${status.className}`}
+			>
+				{status.label}
+			</span>
+
+			{canSend && (
+				<button
+					type="button"
+					onClick={() => onSend(campaign)}
+					className="text-[14px] text-foreground underline underline-offset-4 shrink-0 cursor-pointer"
+				>
+					{campaign.status === 'FAILED' ? 'Повторить' : 'Отправить'}
+				</button>
+			)}
+
+			{campaign.status !== 'SENDING' && (
+				<button
+					type="button"
+					onClick={() => onDelete(campaign)}
+					aria-label="Удалить"
+					className="size-9 shrink-0 rounded-full flex items-center justify-center hover:bg-danger/10 transition-colors cursor-pointer"
+				>
+					<TrashIcon className="size-5 text-danger" />
+				</button>
+			)}
+		</div>
+	)
+}
