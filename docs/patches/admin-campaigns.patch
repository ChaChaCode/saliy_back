@@ -0,0 +1,64 @@
+import { Button } from '@/components/ui/Button'
+import { Dialog } from '@/components/ui/Dialog'
+import { useNotifyAboutProduct } from '@/hooks/useCampaigns'
+import { useNewsletterStats } from '@/hooks/useNewsletter'
+import type { Product } from '@/types/product'
+import { apiErrorMessage } from '@/utils/apiError'
+import { formatDateTime } from '@/utils/format'
+import { useState } from 'react'
+import toast from 'react-hot-toast'
+
+export function ProductNotifyButton({ product }: { product: Product }) {
+	const [confirmOpen, setConfirmOpen] = useState(false)
+	const notify = useNotifyAboutProduct(product.id)
+	const { data: stats } = useNewsletterStats()
+
+	if (product.newsletterSentAt) {
+		return (
+			<p className="text-[14px] text-secondary text-center">
+				Подписчикам отправлено {formatDateTime(product.newsletterSentAt)}
+			</p>
+		)
+	}
+
+	const handleConfirm = () => {
+		notify.mutate(undefined, {
+			onSuccess: r => {
+				toast.success(`Письмо отправляется: ${r.totalRecipients} получателей`)
+				setConfirmOpen(false)
+			},
+			onError: e => {
+				toast.error(apiErrorMessage(e))
+				setConfirmOpen(false)
+			}
+		})
+	}
+
+	return (
+		<>
+			<Button
+				className="w-full"
+				disabled={!product.isActive}
+				onClick={() => setConfirmOpen(true)}
+			>
+				Уведомить подписчиков
+			</Button>
+			{!product.isActive && (
+				<p className="text-[13px] text-secondary text-center">
+					Товар скрыт — опубликуйте и сохраните его, чтобы разослать
+				</p>
+			)}
+
+			{confirmOpen && (
+				<Dialog
+					title="Отправить письмо о товаре?"
+					description={`Письмо о «${product.name}» уйдёт ${stats?.active ?? 'всем активным'} подписчикам. Для одного товара отправить можно только один раз.`}
+					confirmText="Отправить"
+					loading={notify.isPending}
+					onConfirm={handleConfirm}
+					onClose={() => setConfirmOpen(false)}
+				/>
+			)}
+		</>
+	)
+}
