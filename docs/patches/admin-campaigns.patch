@@ -0,0 +1,58 @@
+import { campaignsService } from '@/services/campaigns.service'
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query'
+
+export function useCampaigns() {
+	return useQuery({
+		queryKey: ['campaigns'],
+		queryFn: () => campaignsService.getList(),
+		// Пока идёт отправка — обновляем прогресс.
+		refetchInterval: query =>
+			query.state.data?.campaigns.some(c => c.status === 'SENDING')
+				? 3000
+				: false
+	})
+}
+
+export function useCreateAndSendCampaign() {
+	const queryClient = useQueryClient()
+	return useMutation({
+		mutationFn: async (input: { subject: string; html: string }) => {
+			const campaign = await campaignsService.create(input.subject, input.html)
+			return campaignsService.send(campaign.id)
+		},
+		onSettled: () => {
+			queryClient.invalidateQueries({ queryKey: ['campaigns'] })
+		}
+	})
+}
+
+export function useSendCampaign() {
+	const queryClient = useQueryClient()
+	return useMutation({
+		mutationFn: (id: string) => campaignsService.send(id),
+		onSettled: () => {
+			queryClient.invalidateQueries({ queryKey: ['campaigns'] })
+		}
+	})
+}
+
+export function useDeleteCampaign() {
+	const queryClient = useQueryClient()
+	return useMutation({
+		mutationFn: (id: string) => campaignsService.delete(id),
+		onSuccess: () => {
+			queryClient.invalidateQueries({ queryKey: ['campaigns'] })
+		}
+	})
+}
+
+export function useNotifyAboutProduct(productId: number) {
+	const queryClient = useQueryClient()
+	return useMutation({
+		mutationFn: () => campaignsService.notifyAboutProduct(productId),
+		onSettled: () => {
+			queryClient.invalidateQueries({ queryKey: ['product', productId] })
+			queryClient.invalidateQueries({ queryKey: ['campaigns'] })
+		}
+	})
+}
