@@ -0,0 +1,171 @@
+import { CampaignItem } from '@/components/elements/campaigns/CampaignItem'
+import { Button } from '@/components/ui/Button'
+import { Dialog } from '@/components/ui/Dialog'
+import { Input } from '@/components/ui/Input'
+import { Loader } from '@/components/ui/Loader'
+import { Textarea } from '@/components/ui/Textarea'
+import {
+	useCampaigns,
+	useCreateAndSendCampaign,
+	useDeleteCampaign,
+	useSendCampaign
+} from '@/hooks/useCampaigns'
+import { useNewsletterStats } from '@/hooks/useNewsletter'
+import type { Campaign } from '@/types/campaign'
+import { apiErrorMessage } from '@/utils/apiError'
+import { textToEmailHtml } from '@/utils/emailHtml'
+import { useState } from 'react'
+import toast from 'react-hot-toast'
+
+export function CampaignsContainer() {
+	const [subject, setSubject] = useState('')
+	const [text, setText] = useState('')
+	const [confirmNew, setConfirmNew] = useState(false)
+	const [toSend, setToSend] = useState<Campaign | null>(null)
+	const [toDelete, setToDelete] = useState<Campaign | null>(null)
+
+	const { data, isPending, isError } = useCampaigns()
+	const { data: stats } = useNewsletterStats()
+	const createAndSend = useCreateAndSendCampaign()
+	const send = useSendCampaign()
+	const remove = useDeleteCampaign()
+
+	const activeCount = stats?.active ?? 0
+	const canCreate = subject.trim() !== '' && text.trim() !== ''
+
+	const handleCreateAndSend = () => {
+		createAndSend.mutate(
+			{ subject: subject.trim(), html: textToEmailHtml(text) },
+			{
+				onSuccess: r => {
+					toast.success(`Рассылка запущена: ${r.totalRecipients} получателей`)
+					setSubject('')
+					setText('')
+					setConfirmNew(false)
+				},
+				onError: e => {
+					toast.error(apiErrorMessage(e))
+					setConfirmNew(false)
+				}
+			}
+		)
+	}
+
+	const handleSend = () => {
+		if (!toSend) return
+		send.mutate(toSend.id, {
+			onSuccess: r => {
+				toast.success(`Рассылка запущена: ${r.totalRecipients} получателей`)
+				setToSend(null)
+			},
+			onError: e => {
+				toast.error(apiErrorMessage(e))
+				setToSend(null)
+			}
+		})
+	}
+
+	const handleDelete = () => {
+		if (!toDelete) return
+		remove.mutate(toDelete.id, {
+			onSuccess: () => {
+				toast.success('Рассылка удалена')
+				setToDelete(null)
+			},
+			onError: () => toast.error('Не удалось удалить')
+		})
+	}
+
+	const campaigns = data?.campaigns ?? []
+
+	return (
+		<div className="flex flex-col pb-10 gap-8">
+			<section className="flex flex-col gap-4">
+				<h2 className="text-[20px] font-medium">Новое письмо подписчикам</h2>
+				<p className="text-[14px] text-secondary">
+					Уйдёт активным подписчикам рассылки: сейчас их {activeCount}. Ссылка
+					на отписку добавляется в письмо автоматически. Письмо о новом товаре
+					удобнее отправить кнопкой на странице товара.
+				</p>
+				<Input
+					placeholder="Тема письма"
+					value={subject}
+					onChange={e => setSubject(e.target.value)}
+					maxLength={200}
+				/>
+				<Textarea
+					placeholder="Текст письма. Пустая строка начинает новый абзац."
+					value={text}
+					onChange={e => setText(e.target.value)}
+					rows={8}
+				/>
+				<div>
+					<Button
+						disabled={!canCreate || activeCount === 0}
+						onClick={() => setConfirmNew(true)}
+					>
+						Отправить подписчикам
+					</Button>
+				</div>
+			</section>
+
+			<section className="flex flex-col gap-4">
+				<h2 className="text-[20px] font-medium">История рассылок</h2>
+				{isPending ? (
+					<div className="flex items-center justify-center py-12">
+						<Loader />
+					</div>
+				) : isError ? (
+					<p className="text-foreground">Ошибка загрузки</p>
+				) : campaigns.length === 0 ? (
+					<p className="text-secondary pl-2">Рассылок пока не было</p>
+				) : (
+					<div className="flex flex-col gap-2">
+						{campaigns.map(c => (
+							<CampaignItem
+								key={c.id}
+								campaign={c}
+								onSend={setToSend}
+								onDelete={setToDelete}
+							/>
+						))}
+					</div>
+				)}
+			</section>
+
+			{confirmNew && (
+				<Dialog
+					title="Отправить письмо?"
+					description={`«${subject.trim()}» уйдёт ${activeCount} подписчикам. Отменить отправку будет нельзя.`}
+					confirmText="Отправить"
+					loading={createAndSend.isPending}
+					onConfirm={handleCreateAndSend}
+					onClose={() => setConfirmNew(false)}
+				/>
+			)}
+
+			{toSend && (
+				<Dialog
+					title="Отправить рассылку?"
+					description={`«${toSend.subject}» уйдёт всем активным подписчикам.`}
+					confirmText="Отправить"
+					loading={send.isPending}
+					onConfirm={handleSend}
+					onClose={() => setToSend(null)}
+				/>
+			)}
+
+			{toDelete && (
+				<Dialog
+					title="Удалить рассылку?"
+					description={`«${toDelete.subject}» пропадёт из истории. Уже отправленные письма это не отзовёт.`}
+					confirmText="Удалить"
+					danger
+					loading={remove.isPending}
+					onConfirm={handleDelete}
+					onClose={() => setToDelete(null)}
+				/>
+			)}
+		</div>
+	)
+}
