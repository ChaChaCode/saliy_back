+import { api } from '@/api/client'
+import type {
+	Campaign,
+	CampaignsListResponse,
+	SendCampaignResponse
+} from '@/types/campaign'
+
+export const campaignsService = {
+	getList: (page = 1) =>
+		api
+			.get<CampaignsListResponse>('/admin/campaigns', { params: { page } })
+			.then(r => r.data),
+
+	// Маркетинговые письма — только подписчикам (у них есть согласие и отписка).
+	create: (subject: string, html: string) =>
+		api
+			.post<Campaign>('/admin/campaigns', {
+				subject,
+				html,
+				targetType: 'NEWSLETTER'
+			})
+			.then(r => r.data),
+
+	send: (id: string) =>
+		api
+			.post<SendCampaignResponse>(`/admin/campaigns/${id}/send`)
+			.then(r => r.data),
+
+	delete: (id: string) =>
+		api
+			.delete<{ success: boolean }>(`/admin/campaigns/${id}`)
+			.then(r => r.data),
+
+	notifyAboutProduct: (productId: number) =>
+		api
+			.post<SendCampaignResponse>(`/admin/campaigns/product/${productId}`)
+			.then(r => r.data)
+}
