+const escapeHtml = (value: string) =>
+	value.replace(/[&<>"']/g, c => `&#${c.charCodeAt(0)};`)
+
+/**
+ * Обычный текст из формы → HTML письма в стиле магазина.
+ * Абзацы разделяются пустой строкой, переносы строк сохраняются.
+ * Ссылку на отписку backend добавляет сам.
+ */
+export function textToEmailHtml(text: string): string {
+	const paragraphs = text
+		.trim()
+		.split(/\n\s*\n/)
+		.map(
+			p =>
+				`<p style="margin: 0 0 16px; font-size: 15px; line-height: 1.6; color: #121212;">${escapeHtml(p.trim()).replace(/\n/g, '<br/>')}</p>`
+		)
+		.join('')
+
+	return `
+		<div style="max-width: 480px; margin: 0 auto; font-family: Arial, sans-serif; background: #ffffff;">
+			<div style="text-align: center; padding: 24px 0; font-size: 18px; font-weight: bold; letter-spacing: 4px; color: #121212;">SALIY CLOTHES</div>
+			<div style="padding: 0 16px 8px;">${paragraphs}</div>
+		</div>
+	`
+}
