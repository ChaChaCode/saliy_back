+export class ProductImageUploadError extends Error {
+	product: Product
+	uploadedCount: number
+	originalError: unknown
+	constructor(product: Product, uploadedCount: number, originalError: unknown) {
+		super(`Загружено ${uploadedCount} фото. Остальные фото не удалось загрузить.`)
+		this.product = product
+		this.uploadedCount = uploadedCount
+		this.originalError = originalError
+	}
+}
+
+function imageBatches(files: File[]): File[][] {
+	const batches: File[][] = []
+	let batch: File[] = []
+	let bytes = 0
+	for (const file of files) {
+		if (!/^image\/(jpeg|jpg|png|webp)$/.test(file.type))
+			throw new Error(`«${file.name}»: поддерживаются JPG, PNG и WebP`)
+		if (file.size > 10 * 1024 * 1024)
+			throw new Error(`«${file.name}»: размер фото должен быть не больше 10 МБ`)
+		if (batch.length === 10 || bytes + file.size > 20 * 1024 * 1024) {
+			batches.push(batch)
+			batch = []
+			bytes = 0
+		}
+		batch.push(file)
+		bytes += file.size
+	}
+	if (batch.length) batches.push(batch)
+	return batches
+}
+
+async function uploadImageBatches(id: number, batches: File[][], onUploaded?: (count: number, product: Product) => void) {
+	let product: Product | undefined
+	let uploadedCount = 0
+	for (const batch of batches) {
+		const data = new FormData()
+		batch.forEach(file => data.append('images', file))
+		try {
+			product = (await api.post<{ message: string; product: Product }>(`/admin/products/${id}/images`, data)).data.product
+		} catch (error) {
+			if (product) throw new ProductImageUploadError(product, uploadedCount, error)
+			throw error
+		}
+		uploadedCount += batch.length
+		onUploaded?.(batch.length, product)
+	}
+	return product
+}
+
