+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { authService } from './auth'
+import { api, ApiRequestError } from '@/lib/api'
+
+const fetchMock = vi.fn()
+function response(body: unknown, status = 200) {
+  return new Response(JSON.stringify(body), { status, headers: { 'Content-Type': 'application/json' } })
+}
+beforeEach(() => { fetchMock.mockReset(); vi.stubGlobal('fetch', fetchMock) })
+afterEach(() => vi.unstubAllGlobals())
+
+describe('Better Auth storefront contract', () => {
+  it('sends a sign-in email OTP using the current API', async () => {
+    fetchMock.mockResolvedValue(response({ success: true }))
+    await authService.sendCode('buyer@example.com')
+    expect(fetchMock).toHaveBeenCalledTimes(1)
+    expect(fetchMock.mock.calls[0][0]).toMatch(/\/session\/email-otp\/send-verification-otp$/)
+    expect(JSON.parse(fetchMock.mock.calls[0][1].body)).toEqual({ email: 'buyer@example.com', type: 'sign-in' })
+    expect(fetchMock.mock.calls[0][1].credentials).toBe('include')
+  })
+  it('maps the form code to otp for sign-in', async () => {
+    fetchMock.mockResolvedValue(response({ user: { id: 'user' } }))
+    await authService.verifyCode('buyer@example.com', '1234')
+    expect(fetchMock.mock.calls[0][0]).toMatch(/\/session\/sign-in\/email-otp$/)
+    expect(JSON.parse(fetchMock.mock.calls[0][1].body)).toEqual({ email: 'buyer@example.com', otp: '1234' })
+  })
+  it('accepts a null guest session without refreshing tokens', async () => {
+    fetchMock.mockResolvedValue(response(null))
+    expect(await authService.getSession()).toBeNull()
+    expect(fetchMock).toHaveBeenCalledTimes(1)
+    expect(fetchMock.mock.calls[0][0]).toMatch(/\/session\/get-session$/)
+    expect(fetchMock.mock.calls[0][1].method).toBe('GET')
+  })
+  it('signs out using the current API', async () => {
+    fetchMock.mockResolvedValue(response({ success: true }))
+    await authService.logout()
+    expect(fetchMock.mock.calls[0][0]).toMatch(/\/session\/sign-out$/)
+    expect(fetchMock.mock.calls[0][1].method).toBe('POST')
+  })
+  it('preserves Better Auth error messages and codes', async () => {
+    fetchMock.mockResolvedValue(response({ message: 'Invalid OTP', code: 'INVALID_OTP' }, 400))
+    await expect(authService.verifyCode('buyer@example.com', '0000')).rejects.toMatchObject({ message: 'Invalid OTP', statusCode: 400, error: 'INVALID_OTP' })
+  })
+  it('does not retry unauthorized requests against the removed refresh endpoint', async () => {
+    fetchMock.mockResolvedValue(response({ message: 'Unauthorized', statusCode: 401, error: 'Unauthorized' }, 401))
+    await expect(api.get('/cart')).rejects.toBeInstanceOf(ApiRequestError)
+    expect(fetchMock).toHaveBeenCalledTimes(1)
+  })
+})
