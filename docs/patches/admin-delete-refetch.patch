+import { MutationCache, QueryClient, type QueryKey } from '@tanstack/react-query'
+
+const startsWith = (key: QueryKey, prefix: readonly unknown[]) =>
+	prefix.every((part, i) => JSON.stringify(key[i]) === JSON.stringify(part))
 
 export const queryClient = new QueryClient({
 	mutationCache: new MutationCache({
-		onSuccess: async () => {
-			await queryClient.invalidateQueries()
+		// После любой успешной мутации перечитываем данные. Удалённый объект
+		// (meta.removes — ключ его запроса) не перечитываем: он ответит 404 и
+		// страница покажет «Не удалось загрузить» перед переходом к списку.
+		onSuccess: async (_data, _variables, _onMutateResult, mutation) => {
+			const removes = mutation.meta?.removes as readonly unknown[] | undefined
+			await queryClient.invalidateQueries(
+				removes
+					? { predicate: query => !startsWith(query.queryKey, removes) }
+					: undefined
+			)
 		}
 	}),
 	defaultOptions: {
